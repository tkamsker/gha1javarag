# ==============================================================================
# Java Codebase Indexer Pipeline - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your specific values
# DO NOT commit .env to version control

# ==============================================================================
# Required: Java Source Code Directory
# ==============================================================================
# Root directory containing Java source code to analyze
# The discover command will recursively scan this directory for Maven projects
JAVA_SOURCE_DIR=/path/to/your/java/source

# ==============================================================================
# Weaviate Vector Database Configuration
# ==============================================================================
# Weaviate instance URL (default: local Docker instance)
WEAVIATE_URL=http://localhost:8080

# Weaviate API key (optional, leave empty for anonymous access)
WEAVIATE_API_KEY=

# Connection timeout in seconds
WEAVIATE_TIMEOUT=60

# Batch size for indexing operations (default: 50, tune for performance)
WEAVIATE_BATCH_SIZE=50

# ==============================================================================
# Ollama AI Configuration
# ==============================================================================
# Ollama base URL for Python code running on the HOST
#
# IMPORTANT: Different URLs for different execution contexts:
#
# 1. For host-side Python code (run-cuco.sh, run.sh, CLI commands):
#    - macOS: http://localhost:11434
#    - Linux: http://localhost:11434
#    USE THIS ONE → The scripts run on your machine, NOT in Docker
#
# 2. For code running INSIDE Docker containers (Weaviate, etc.):
#    - macOS: http://host.docker.internal:11434 (handled by docker-compose.macos.yml)
#    - Linux: http://127.0.0.1:11434 (handled by docker-compose.ubuntu.yml + network_mode: host)
#    DO NOT SET THIS HERE → Docker compose files handle this automatically
#
# Default for host execution (both macOS and Linux):
OLLAMA_BASE_URL=http://localhost:11434
#
# NEVER use host.docker.internal for host-side Python code!
# OLLAMA_BASE_URL=http://host.docker.internal:11434  # ❌ WRONG for host execution!

# Ollama model name for semantic understanding (default: gemma3:12b)
OLLAMA_MODEL_NAME=gemma3:12b

# Ollama request timeout in seconds (AI operations can be slow)
OLLAMA_TIMEOUT=240

# ==============================================================================
# Performance Tuning
# ==============================================================================
# Maximum concurrent AI calls to Ollama (default: 10)
# Higher values = faster extraction but more resource usage
MAX_CONCURRENT_AI_CALLS=10

# Output directory for intermediate files (inventory, extraction results)
# For Feature 001 (discovery, extract, index): stores inventory.json, extraction_result.json
OUTPUT_DIR=./data

# ==============================================================================
# PRD Generation Configuration (Feature 002)
# ==============================================================================
# Output directory for PRD generation artifacts
# Structure: output/{database,services,frontend,business_rules,prd}/
# Default: ./output (separate from Feature 001 data directory)
PRD_OUTPUT_DIR=./output

# ==============================================================================
# Logging Configuration
# ==============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Enable verbose logging for detailed diagnostics
VERBOSE_LOGGING=false

# ==============================================================================
# Optional: Processing Controls
# ==============================================================================
# Enable dry-run mode (process but don't index to Weaviate)
DRY_RUN=false

# Skip Weaviate schema creation (assumes schema already exists)
SKIP_SCHEMA_CREATION=false

# Maximum file size in bytes to process (default: 2MB)
MAX_FILE_BYTES=2000000

# File types to include (comma-separated extensions)
INCLUDE_FILE_TYPES=.java,.jsp,.xml,.html,.js,.sql,.properties,.json,.md

# Directories to exclude from discovery (comma-separated)
EXCLUDE_DIRS=.git,node_modules,build,out,target,dist,.idea,.vscode

# ==============================================================================
# Embedding Configuration (for future use)
# ==============================================================================
# Embedding provider: weaviate_ollama (default) or client
EMBEDDING_PROVIDER=weaviate_ollama

# Model for text2vec-ollama module
EMBEDDING_MODEL=nomic-embed-text
